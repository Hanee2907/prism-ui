{
  "name": "prism-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Prism UI: a design system made of light. Frosted glass, soft gradients and one rainbow through every component.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build -c vite.lib.config.ts && npm run build:react && npm run build:storybook",
    "build:react": "vite build -c vite.react.config.ts && tsc -p tsconfig.react.json",
    "build:storybook": "storybook build -o dist/storybook --quiet",
    "storybook": "storybook dev -p 6006",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.1.1",
    "jsdom": "^25.0.1",
    "storybook": "^8.4.7",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.49.1"
    }
  }
}
